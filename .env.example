# Copy to .env and fill in. Never commit .env (see SECURITY.md).
# Variable names only here — no values.

# Meta Model API (required)
MODEL_API_KEY=
WINNOW_MODEL=muse-spark-1.3

# Test / eval behaviour
WINNOW_LLM_MODE=live
WINNOW_ALLOW_CONTRIBUTOR=0

# GitHub App (required for serve / webhook)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Server
WINNOW_DATA_DIR=./data
WINNOW_PUBLIC_BASE_URL=http://localhost:8000
WINNOW_PUBLIC_REPOS=
WINNOW_DAILY_SPEND_USD=20
WINNOW_ADMIN_TOKEN=
WINNOW_LOG_PROMPTS=0
WINNOW_LOG_LEVEL=INFO
WINNOW_WORKERS=2
